{
  "name": "trinity-operational-center",
  "version": "10.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "wrangler deploy --env=\"\"",
    "types": "wrangler types",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:truth-live": "node scripts/live-truth-test.mjs",
    "build:development": "wrangler deploy --dry-run --env development --outdir dist-development",
    "deploy:development": "wrangler deploy --env development",
    "migrate:development": "wrangler d1 migrations apply trinity-development --remote --env development"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.28.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true,
    "workerd@1.20261006.1": true
  }
}
