{
  "name": "trinity-operational-center",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "node scripts/build-mcp-app.mjs && wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "node scripts/build-mcp-app.mjs && wrangler deploy --env=\"\"",
    "types": "wrangler types",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:truth-live": "node scripts/live-truth-test.mjs",
    "build:development": "node scripts/build-mcp-app.mjs && wrangler deploy --dry-run --env development --outdir dist-development",
    "deploy:development": "node scripts/build-mcp-app.mjs && wrangler deploy --env development",
    "migrate:development": "wrangler d1 migrations apply trinity-development --remote --env development",
    "build:chat-maintainer": "wrangler deploy --dry-run --config ../Chat-Maintenance-Worker/wrangler.jsonc --outdir ../Chat-Maintenance-Worker/dist",
    "deploy:chat-maintainer": "wrangler deploy --config ../Chat-Maintenance-Worker/wrangler.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "agents": "0.28.1",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.30.1"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true,
    "workerd@1.20261006.1": true,
    "workerd@1.20261012.1": true
  }
}
