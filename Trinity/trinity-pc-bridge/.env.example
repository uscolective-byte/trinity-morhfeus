# ═══════════════════════════════════════════════
# Trinity PC Bridge — NextGen konfigurácia
# Skopíruj ako .env a vyplň hodnoty
# ═══════════════════════════════════════════════

# ── Povinné ──
# Trinity gateway kľúč (min. 32 znakov) — musí zhodovať s TRINITY_GATEWAY_KEY Worker secretom
TRINITY_GATEWAY_KEY=changeme-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Trinity URL
TRINITY_URL=https://auru.dev

# Poll interval v ms (odporúčané: 5000)
POLL_INTERVAL=5000

# Max veľkosť base64 payloadu (KB) — pre screenshot atď.
MAX_PAYLOAD_KB=512

# Povolené lokálne priečinky. Oddeľ ich bodkočiarkou.
# Čítanie aj zápis sú odmietnuté mimo týchto koreňov.
TRINITY_WORKSPACE_ROOTS=C:\Users\YOUR_USER\Documents\Codex

# Povolené aliasy aplikácií (nikdy nie ľubovoľné exe/cesty)
TRINITY_ALLOWED_APPS=notepad,calculator,paint,explorer,chrome,edge

# Ľubovoľný shell je predvolene zakázaný aj po schválení akcie.
TRINITY_ALLOW_SHELL=false

# Limity internetových operácií
TRINITY_WEB_MAX_KB=1024
TRINITY_DOWNLOAD_MAX_MB=10

# ── GitHub ──
# GitHub Personal Access Token (repo scope)
GITHUB_TOKEN=
# Formát: vlastník/repozitar (napr. saboivan2008/Trinity)
GITHUB_REPO=

# ── Supabase ──
# URL projektu (napr. https://xyz.supabase.co)
SUPABASE_URL=
# anon alebo service_role kľúč
SUPABASE_KEY=

# ── Firebase (service account) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Súkromný kľúč — \n ako oddeľovač riadkov
FIREBASE_PRIVATE_KEY=

# ── Firecrawl ──
FIRECRAWL_API_KEY=

# ── Postman Newman ──
POSTMAN_API_KEY=
# ID Postman Collection pre auto-testy
POSTMAN_COLLECTION_ID=
