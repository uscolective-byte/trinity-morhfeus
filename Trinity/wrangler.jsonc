{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trinity",
  "main": "src/index.js",
  "account_id": "b60342e5e52f5646fbd4e913bb409334",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "zod": "./node_modules/zod"
  },
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "auru.space",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *",
      "0 0 * * *",
      "0 11 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "limits": {
    "cpu_ms": 30000
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.webp"
      ],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*.css",
        "**/*.js.txt"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "b60342e5e52f5646fbd4e913bb409334",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "AI_FAST_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "OPENAI_MODEL": "gpt-4.1-mini",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "STT_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "TTS_MODEL": "@cf/myshell-ai/melotts",
    "OLLAMA_MODEL": "gemma4:31b",
    "TRINITY_ADMIN_EMAILS": "saboivan2008@gmail.com,usc31@auru.space,uscolective@gmail.com,delirium.trade12@gmail.com",
    "TRINITY_OWNER_EMAIL": "saboivan2008@gmail.com",
    "TRINITY_OWNER_EMAILS": "saboivan2008@gmail.com,uscolective@gmail.com,usc31@auru.space",
    "GOOGLE_ENABLED": "false",
    "GOOGLE_CLIENT_ID": "618392104829-trinity-auru-space.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://auru.space/auth/google/callback",
    "GOOGLE_PROJECT_ID": "tangential-osprey-dl7cp",
    "FIREBASE_PROJECT_ID": "trinity-morhfeus-20261001",
    "GOOGLE_SERVICES_ENABLED": "generativelanguage.googleapis.com,aiplatform.googleapis.com,cloudresourcemanager.googleapis.com,storage.googleapis.com,firestore.googleapis.com,people.googleapis.com,drive.googleapis.com,docs.googleapis.com,sheets.googleapis.com",
    "TRINITY_ENV": "production",
    "ENVIRONMENT": "production",
    "STRICT_MODE": "true",
    "DEBUG_LOGGING": "false",
    "ENABLE_EXPERIMENTAL_MODELS": "false",
    "TRINITY_TAP_ENABLED": "true",
    "TRINITY_TAP_PRODUCTION": "diagnostic-only",
