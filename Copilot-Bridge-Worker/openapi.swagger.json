{
  "swagger": "2.0",
  "info": {
    "title": "Trinity Copilot Bridge",
    "version": "0.1.0",
    "description": "Microsoft Entra delegated read-only access and optional scoped tasks. Replace host and configure OAuth in Power Platform."
  },
  "host": "REPLACE_WITH_DEPLOYED_CLOUDFLARE_WORKER_HOST",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/trinity/status": {
      "get": {
        "operationId": "GetTrinityStatus",
        "summary": "Status of Trinity service",
        "tags": [
          "Trinity"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/trinity/readiness": {
      "get": {
        "operationId": "GetTrinityReadiness",
        "summary": "Readiness summary",
        "tags": [
          "Trinity"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "$ref": "#/definitions/Readiness"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/trinity/agents": {
      "get": {
        "operationId": "ListTrinityAgents",
        "summary": "Read-only agent catalog",
        "tags": [
          "Trinity"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "$ref": "#/definitions/AgentCatalog"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/trinity/tasks": {
      "post": {
        "operationId": "SubmitTrinityTask",
        "summary": "Queue an allowed non-admin task; optional Trinity.Execute permission",
        "tags": [
          "Trinity"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TaskInput"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Queued task, not completed",
            "schema": {
              "$ref": "#/definitions/TaskReceipt"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Task blocked"
          }
        }
      }
    },
    "/v1/trinity/tasks/{id}": {
      "get": {
        "operationId": "GetTrinityTask",
        "summary": "Read task execution status",
        "tags": [
          "Trinity"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "$ref": "#/definitions/TaskStatus"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "definitions": {
    "Status": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "agents_count": {
          "type": "integer"
        }
      }
    },
    "Readiness": {
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "Agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cluster": {
          "type": "string"
        }
      }
    },
    "AgentCatalog": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Agent"
          }
        }
      }
    },
    "TaskInput": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "TaskReceipt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        }
      }
    },
    "TaskStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      }
    }
  }
}
