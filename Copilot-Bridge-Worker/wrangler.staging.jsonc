{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trinity-copilot-bridge-development",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": {"enabled": true},
  "vars": {"ENTRA_ENABLE_TASKS": "false"},
  "services": [{"binding": "TRINITY", "service": "trinity-development"}]
}
