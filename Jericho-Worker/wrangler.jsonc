{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jericho123",
  "main": "src/index.js",
  "account_id": "b60342e5e52f5646fbd4e913bb409334",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "jericho123.auru.space",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "SERVICE_NAME": "Jericho123",
    "VERSION": "1.0.0",
    "ENVIRONMENT": "production"
  },
  "env": {
    "development": {
      "name": "jericho123-development",
      "routes": [
        {
          "pattern": "jericho123.auru.dev",
          "custom_domain": true
        }
      ],
      "vars": {
        "SERVICE_NAME": "Jericho123",
        "VERSION": "1.0.0",
        "ENVIRONMENT": "development"
      }
    }
  }
}
